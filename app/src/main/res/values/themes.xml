<resources>
    <style name="Theme.SpendTracker" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch theme: brand-green splash with the animated ring icon, then hands over to the app theme. -->
    <style name="Theme.SpendTracker.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0F4A3C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.SpendTracker</item>
    </style>
</resources>
