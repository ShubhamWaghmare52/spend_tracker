<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis (30 min, the minimum) mainly resets "today" after midnight;
     payments and limit changes refresh the widget immediately. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="80dp"
    android:targetCellWidth="3"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_spend"
    android:previewLayout="@layout/widget_spend"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_description" />
